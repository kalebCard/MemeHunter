# Copiar a .env (no se versiona). Freqtrade lee variables FREQTRADE__<SECCION>__<CLAVE>.
# Fase 0/1: no se necesitan API keys reales (backtest y dry-run usan datos públicos).
# Descomenta SOLO las que vayas a usar: un valor vacío rompe la validación del config.

# FREQTRADE__EXCHANGE__KEY=
# FREQTRADE__EXCHANGE__SECRET=

# --- Sprint 4: notificaciones y FreqUI ---
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=
# FREQTRADE__API_SERVER__ENABLED=true
# FREQTRADE__API_SERVER__JWT_SECRET_KEY=
# FREQTRADE__API_SERVER__WS_TOKEN=
# FREQTRADE__API_SERVER__PASSWORD=

# --- Sprint 1 (2026): Cockpit Dashboard API Security & Zero-Trust ---
# Token Bearer obligatorio (min 32 caracteres criptográficos). Generar con: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_API_TOKEN=genera_un_token_seguro_de_32_bytes_hexadecimal
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088,http://127.0.0.1:8080,http://localhost:8080

# --- Motor Cognitivo LLM (OpenRouter) ---
# OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
# OPENROUTER_MAX_DAILY_TOKENS=150000

# --- Bóveda Criptográfica en Reposo (AES-256-GCM) ---
# Clave simétrica maestra para user_data/.secrets.vault
# VAULT_MASTER_KEY=clave_maestra_hexadecimal_de_32_bytes

