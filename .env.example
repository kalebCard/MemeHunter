# ==============================================================================
# Meme Hunter - Variables de Entorno y Configuración (.env)
# ==============================================================================
# Copia este archivo a '.env':
#   cp .env.example .env
# Las variables aquí definidas son inyectadas automáticamente al contenedor.

# ------------------------------------------------------------------------------
# 1. Binance Futures API (Obligatorio para Live Trading / Opcional para Dry-Run)
# ------------------------------------------------------------------------------
# Si operas en Dry-Run (simulación), déjalas comentadas o vacías.
# FREQTRADE__EXCHANGE__KEY=tu_api_key_de_binance
# FREQTRADE__EXCHANGE__SECRET=tu_api_secret_de_binance

# ------------------------------------------------------------------------------
# 2. Notificaciones y Control Remoto en Telegram (Recomendado)
# ------------------------------------------------------------------------------
# Obtén tu TOKEN en Telegram hablando con @BotFather.
# Obtén tu CHAT_ID hablando con @userinfobot.
FREQTRADE__TELEGRAM__ENABLED=false
# FREQTRADE__TELEGRAM__TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# FREQTRADE__TELEGRAM__CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 3. Consola Web FreqUI (:8081) y Seguridad API
# ------------------------------------------------------------------------------
# Credenciales para acceder a http://localhost:8081
FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__LISTEN_PORT=8081
FREQTRADE__API_SERVER__USERNAME=admin
FREQTRADE__API_SERVER__PASSWORD=MemeHunter2026!
FREQTRADE__API_SERVER__JWT_SECRET_KEY=meme_hunter_futures_jwt_key_2026_super_secure_99

# ------------------------------------------------------------------------------
# 4. Motor Cognitivo LLM / OpenRouter (Opcional para Incubadora)
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
# OPENROUTER_MAX_DAILY_TOKENS=150000

# ------------------------------------------------------------------------------
# 5. Directorio de Datos Externo (Opcional)
# ------------------------------------------------------------------------------
# Por defecto se usa ./data en la raíz del proyecto.
# MEME_DATA_DIR=./data
