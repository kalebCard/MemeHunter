# Copiar a .env (no se versiona). Freqtrade lee variables FREQTRADE__<SECCION>__<CLAVE>.
# Fase 0/1: no se necesitan API keys reales (backtest y dry-run usan datos públicos).
# Descomenta SOLO las que vayas a usar: un valor vacío rompe la validación del config.

# FREQTRADE__EXCHANGE__KEY=
# FREQTRADE__EXCHANGE__SECRET=

# --- Sprint 4: notificaciones y FreqUI ---
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=
# FREQTRADE__API_SERVER__ENABLED=true
# FREQTRADE__API_SERVER__JWT_SECRET_KEY=
# FREQTRADE__API_SERVER__WS_TOKEN=
# FREQTRADE__API_SERVER__PASSWORD=
