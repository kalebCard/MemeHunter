            "ADAUP/USDT",
            "ADX/USDT",
            "AERGO/USDT",
            "AERO/USDT",
            "AEUR/USDT",
            "AEVO/USDT",
            "AGIX/USDT",
            "AGLD/USDT",
            "AI/USDT",
            "AIGENSYN/USDT",
            "AION/USDT",
            "AIXBT/USDT",
            "AKRO/USDT",
            "ALCX/USDT",
            "ALGO/USDT",
            "ALICE/USDT",
            "ALLO/USDT",
            "ALPACA/USDT",
            "ALPHA/USDT",
            "ALPINE/USDT",
            "ALT/USDT",
