{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "MemeHunter_Moonshot_10x",
    "dry_run": true,
    "dry_run_wallet": 10.0,
    "trading_mode": "futures",
    "margin_mode": "isolated",

    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "max_open_trades": 1,
    "tradable_balance_ratio": 0.99,
    "amend_last_stake_amount": true,
    "fiat_display_currency": "USD",

    "timeframe": "15m",
    "stoploss": -0.045,

    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },

    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 5,
        "exit": 5,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": true,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "1000PEPE/USDT:USDT",
            "DOGE/USDT:USDT",
            "SHIB/USDT:USDT",
            "SOL/USDT:USDT",
            "SUI/USDT:USDT"
        ],
        "pair_blacklist": [
            "(BTC|ETH)UP/.*",
            "(BTC|ETH)DOWN/.*",
            ".*BEAR/.*",
            ".*BULL/.*"
        ]
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "api_server": {
        "enabled": false
    },
    "telegram": {
        "enabled": false
    }
}
